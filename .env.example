# =============================================================
# aptpick 환경 변수 예시 파일
# - 로컬: 이 파일을 .env 로 복사해서 사용 (cp .env.example .env)
# - Render / Netlify / AWS: [RENDER-API] [RENDER-FRONT] [NETLIFY] [AWS] 표시 항목을 각 대시보드/서버에 직접 등록
# - 키 이름과 설명만 기록합니다. 실제 값과 Secret 은 절대 커밋하지 않습니다.
# =============================================================

# ---------- [BACKEND] Database (TiDB Cloud) / [RENDER-API] [AWS] ----------
# DATABASE_URL 이 비어 있으면 TIDB_* 로 접속 URL 을 조립합니다. 둘 다 비어 있으면 로컬 SQLite 사용
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
# 데이터베이스 이름은 반드시 aptpick (없으면 기동 시 CREATE DATABASE IF NOT EXISTS)
TIDB_DATABASE=aptpick
# VERIFY_IDENTITY | VERIFY_CA | DISABLED
TIDB_SSL_MODE=VERIFY_IDENTITY
# 직접 지정 예) mysql+pymysql://USER:PASSWORD@HOST:4000/aptpick
DATABASE_URL=

# ---------- [BACKEND] 공통 / [RENDER-API] [AWS] ----------
APP_ENV=development
# JWT 서명 키 (Render 는 generateValue 로 자동 생성)
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=720
# 실제 관리자 진입용 보안 키 (로그인 페이지 > 관리자 키 로그인)
ADMIN_SECRET_KEY=
# 실제 관리자 계정 이메일 (관리자 키 로그인 시 이 계정으로 세션 발급)
ADMIN_EMAIL=
# CORS 허용 도메인 (콤마 구분)
CORS_ORIGINS=http://localhost:5173,https://aptpick.netlify.app,https://aptpick.onrender.com,https://aptpick.duckdns.org
# 프런트엔드 주소 (OAuth 로그인 완료 후 리다이렉트)
FRONTEND_URL=http://localhost:5173
# 백엔드 공개 주소 (OAuth redirect_uri 생성용)
BACKEND_URL=http://localhost:8000
# 분당 요청 제한 (IP 기준, 인증 API 는 별도 강화)
RATE_LIMIT_PER_MINUTE=240
# 데이터가 비어 있을 때 '가상 샘플 데이터' 를 적재 (실데이터와 source=sample 로 구분)
SEED_SAMPLE_DATA=true

# ---------- [BACKEND] OAuth 2.0 / [RENDER-API] [AWS] ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ---------- [BACKEND] External APIs / [RENDER-API] [AWS] ----------
# 공공데이터포털 인증키 (국토교통부 아파트 매매·전월세 실거래가 API, 일반 인증키 Decoding 값)
DATA_GO_KR_API_KEY=
# Kakao Local REST API 키 (실거래 단지 주소 → 좌표 변환, 선택)
KAKAO_REST_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------- [FRONTEND] / [RENDER-FRONT] [NETLIFY] ----------
# VITE_ 변수는 브라우저 번들에 노출되므로 공개 가능한 값만 사용합니다.
# Netlify 데모: VITE_USE_MOCK=true (백엔드 없이 Mock 데이터로 동작)
VITE_USE_MOCK=false
VITE_API_BASE_URL=http://localhost:8000
# osm(기본, 키 불필요 Leaflet + OpenStreetMap) | kakao
VITE_MAP_PROVIDER=osm
# Kakao Maps JavaScript 키 (도메인 제한이 걸린 공개 키)
KAKAO_MAP_API_KEY=
VITE_KAKAO_MAP_KEY=
NAVER_MAP_CLIENT_ID=
