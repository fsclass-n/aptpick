# /etc/aptpick/aptpick.env 로 복사 (권한 600). 채운 파일은 절대 커밋하지 않습니다.
APP_ENV=production
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32
ADMIN_SECRET_KEY=
ADMIN_EMAIL=
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=aptpick
TIDB_SSL_MODE=VERIFY_IDENTITY
CORS_ORIGINS=https://aptpick.duckdns.org,https://aptpick.onrender.com,https://aptpick.netlify.app
SEED_SAMPLE_DATA=true
DATA_GO_KR_API_KEY=
KAKAO_REST_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
